{
  "name": "onepage-crm-mcp-server",
  "version": "1.0.0",
  "description": "An open-source Model Context Protocol (MCP) server for the OnePage CRM API. Manage contacts, deals, actions, notes, and pipelines from your AI assistant.",
  "main": "dist/index.js",
  "bin": {
    "onepage-crm-mcp-server": "dist/index.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onepagecrm",
    "crm",
    "contacts",
    "deals",
    "api",
    "ai",
    "claude",
    "llm",
    "automation"
  ],
  "author": "Kess Media <alex@kess.media> (https://kess.media)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkess/onepage-crm-mcp-server"
  },
  "homepage": "https://github.com/alexkess/onepage-crm-mcp-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  }
}
